PREFIX pv: <https://rdfox-stress.example.org/prov/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Walk the provenance hierarchy from one subsection up to its document with a property path.
SELECT ?ancestor ?sectionNumber ?title
WHERE {
  <https://rdfox-stress.example.org/sec/5208/3.5> pv:parentSection+ ?ancestor .
  OPTIONAL { ?ancestor pv:sectionNumber ?sectionNumber }
  ?ancestor pv:title ?title .
}
